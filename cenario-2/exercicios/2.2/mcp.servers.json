{
  "globalTimeoutMs": 4000,
  "maxRetries": 2,
  "backoffBaseMs": 300,
  "servers": [
    {
      "name": "github-mcp",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      },
      "timeoutMs": 5000
    },
    {
      "name": "azure-ai-search-mcp",
      "transport": "http",
      "url": "http://localhost:8081/mcp",
      "method": "POST",
      "headers": {
        "Authorization": "Bearer ${AZURE_SEARCH_TOKEN}"
      },
      "body": {
        "jsonrpc": "2.0",
        "id": "health-check",
        "method": "initialize",
        "params": {
          "protocolVersion": "2024-11-05",
          "capabilities": {},
          "clientInfo": {
            "name": "novatech-health-check",
            "version": "1.0.0"
          }
        }
      },
      "expectStatus": [200]
    },
    {
      "name": "confluence-mcp",
      "transport": "http",
      "url": "http://localhost:8082/mcp",
      "method": "POST",
      "headers": {
        "Authorization": "Bearer ${CONFLUENCE_TOKEN}"
      },
      "expectStatus": [200]
    }
  ]
}
